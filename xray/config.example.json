{
  "log": {"loglevel": "warning"},
  "inbounds": [
    {
      "tag": "transparent",
      "listen": "0.0.0.0",
      "port": 1501,
      "protocol": "dokodemo-door",
      "settings": {"network": "tcp", "followRedirect": true},
      "sniffing": {"enabled": true, "destOverride": ["http", "tls"], "routeOnly": true}
    },
    {
      "tag": "socks-test",
      "listen": "127.0.0.1",
      "port": 1080,
      "protocol": "socks",
      "settings": {"udpEnabled": false}
    }
  ],
  "outbounds": [
    {"tag": "direct", "protocol": "freedom", "settings": {}},
    {
      "tag": "proxy",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "YOUR_SERVER_ADDRESS",
            "port": 443,
            "users": [
              {
                "id": "YOUR_UUID",
                "encryption": "YOUR_ENCRYPTION",
                "level": 8
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "fingerprint": "firefox",
          "serverName": "YOUR_SNI",
          "publicKey": "YOUR_REALITY_PUBLIC_KEY",
          "shortId": "YOUR_SHORT_ID",
          "spiderX": "YOUR_SPIDER_X",
          "mldsa65Verify": "YOUR_MLDSA65_VERIFY"
        },
        "xhttpSettings": {
          "mode": "stream-one",
          "path": "/",
          "host": "",
          "extra": {"mode": "stream-one", "xPaddingBytes": "100-1000"}
        }
      },
      "mux": {"enabled": false, "concurrency": -1}
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {"type": "field", "ip": ["geoip:private"], "outboundTag": "direct"},
      {"type": "field", "source": ["192.168.2.0/24"], "outboundTag": "proxy"},
      {"type": "field", "domain": [
        "geosite:google",
        "geosite:telegram",
        "geosite:instagram",
        "geosite:facebook",
        "geosite:twitter",
        "geosite:discord",
        "geosite:signal",
        "geosite:viber",
        "geosite:linkedin",
        "geosite:vimeo",
        "geosite:whatsapp",
        "geosite:rutracker",
        "domain:threads.net", "domain:threads.com",
        "domain:fna.fbcdn.net", "domain:fbcdn.net", "domain:cdninstagram.org",
        "domain:lostfilm.tv"
      ], "outboundTag": "proxy"},
      {"type": "field", "ip": [
        "91.105.192.0/23", "91.108.4.0/22", "91.108.8.0/22", "91.108.12.0/22",
        "91.108.16.0/22", "91.108.20.0/22", "91.108.56.0/22", "149.154.160.0/20",
        "64.233.160.0/19", "66.102.0.0/20", "72.14.192.0/18", "74.125.0.0/16",
        "108.177.0.0/17", "142.250.0.0/15", "172.217.0.0/16", "173.194.0.0/16",
        "209.85.128.0/17", "216.58.192.0/19",
        "31.13.24.0/21", "31.13.64.0/18", "45.64.40.0/22", "57.144.0.0/14",
        "66.220.144.0/20", "69.63.176.0/20", "69.171.224.0/19", "74.119.76.0/22",
        "102.132.96.0/20", "129.134.0.0/17", "157.240.0.0/16", "163.70.128.0/17",
