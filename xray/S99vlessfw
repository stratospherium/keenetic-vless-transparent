#!/bin/sh
CONF=/opt/etc/xray/config.json
LOG=/opt/var/log/xray-vless.log
WDPID=/opt/var/run/vless-watchdog.pid

start() {
    if ! pidof xray >/dev/null 2>&1; then
        UP=$(cut -d. -f1 /proc/uptime)
        if [ "$UP" -lt 180 ]; then
            sleep 45
        fi
        /opt/sbin/xray -c $CONF >>$LOG 2>&1 &
        sleep 3
    fi
    if pidof xray >/dev/null 2>&1; then
        /opt/etc/xray/fw.sh start
        echo "xray running, rules applied"
        start-stop-daemon -K -p /opt/var/run/phonemon.pid 2>/dev/null
        start-stop-daemon -S -b -m -p /opt/var/run/phonemon.pid -x /bin/sh -- /opt/etc/xray/phone-mon.sh >/dev/null 2>&1
        start-stop-daemon -K -p $WDPID 2>/dev/null
        start-stop-daemon -S -b -m -p $WDPID -x /bin/sh -- /opt/etc/xray/watchdog_loop.sh >/dev/null 2>&1
        echo "watchdog started"
    else
        /opt/etc/xray/fw.sh stop
        echo "XRAY FAILED TO START - rules NOT applied (network stays direct)"
    fi
}

stop() {
    /opt/etc/xray/fw.sh stop
    start-stop-daemon -K -p /opt/var/run/phonemon.pid 2>/dev/null
    start-stop-daemon -K -p $WDPID 2>/dev/null
    killall xray 2>/dev/null
    echo "stopped"
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart)
        stop
        sleep 1
        start
        ;;
    *) echo "usage: $0 {start|stop|restart}" ;;
esac
